# Copy to .env (never commit .env). Claude Code is denied read access to .env.

# API — Postgres from docker-compose.yml
DATABASE_URL=postgresql://covertree:covertree@localhost:5432/covertree
# Integration tests use the separate postgres-test service
TEST_DATABASE_URL=postgresql://covertree:covertree@localhost:5433/covertree_test

# Weatherstack — free tier is HTTP-only (https returns error 105)
WEATHERSTACK_BASE_URL=http://api.weatherstack.com
WEATHERSTACK_ACCESS_KEY=your-access-key

# API port
PORT=4000

# Web
VITE_GRAPHQL_URL=http://localhost:4000/graphql
