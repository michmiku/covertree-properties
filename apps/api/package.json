{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json && cp src/schema.graphql dist/",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen",
    "generate": "prisma generate",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate && graphql-codegen",
    "weatherstack:probe": "tsx scripts/weatherstack-probe.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "graphql": "^17.0.2",
    "graphql-scalars": "^2.0.0",
    "graphql-yoga": "^5.24.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.2",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@types/node": "^26.6.2",
    "msw": "^2.15.0",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.1"
  }
}
